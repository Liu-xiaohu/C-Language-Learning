#include<stdio.h>

void maxmin(int a[],int length,int *min,int *max);
int main()
{
    int a[]={1,2,3,4,5,6,11,12,22,33,44,55,66,};
    int min,max;
    maxmin(a,sizeof(a)/sizeof(a[0]),&min,&max);
    printf("%d %d",min,max);
    return 0;
}

void maxmin(int a[],int length,int *min,int *max)
{
    *min=*max=a[0];
    for(int i=0;i<length;i++)
    {
        if(*min>a[i])
        {
            *min=a[i];
        }
        if(*max<a[i])
        {
            *max=a[i];
        }
    }
}
