#include<stdio.h>

int main()
{
    const int n=10;
    int x;
    int number[n];
    for(int i=0;i<n;i++)
    {
        number[i]=0;
    }
    scanf("%d",&x);
    while(x!=-1)
    {
        if(x>=0&&x<=9)
        {
        number[x]++;    
        }
        scanf("%d",&x);
    }
    for(int i=0;i<n;i++)
    {
     printf("%d:%d\n",i,number[i]);   
    }
}
