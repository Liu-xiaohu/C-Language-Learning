#include <stdio.h>

int main()
{
    int number[100];
    int cnt=0;
    double sum=0;
    double avge;
    scanf("%d",&number[cnt]);
    while(number[cnt]!=-1)
    {
        sum +=number[cnt];
        cnt++;
        scanf("%d",&number[cnt]);
    }
    if(cnt>0)
    {
        avge=sum/cnt;
        printf("%lf\n",avge);
    }
    for(int i=0;i<cnt;i++)
    {

        if(number[i]>avge)
        {
            printf("%d\n",number[i]);
        }
    }
    return 0;
}
